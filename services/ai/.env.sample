# All variables are defined in the root .env.sample.
# For standalone development of this service only, copy the relevant sections below.

OPENAI_API_KEY=sk-...
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=stuffsy_files
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
VISION_MODEL=gpt-4o
WHISPER_MODEL=whisper-1
SIMILARITY_THRESHOLD=0.30
TOP_K=6
CHUNK_SIZE=800
CHUNK_OVERLAP=100
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
S3_BUCKET=
REDIS_URL=redis://localhost:6379
EMBEDDING_QUEUE_KEY=stuffsy:embed
