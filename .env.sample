# ── Server ────────────────────────────────────────────────────────────────────
PORT=9808
BASE_URL=http://localhost:9808

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB=url_shortener
MONGO_COLLECTION=links
MONGO_MAX_RETRIES=10
MONGO_RETRY_INTERVAL=2s

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_ADDR=localhost:6379        # Go API (go-redis format)
REDIS_URL=redis://localhost:6379 # Python AI/worker (redis-py format)
REDIS_PASSWORD=
REDIS_DB=0

# ── AWS / S3 ──────────────────────────────────────────────────────────────────
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET=your-bucket-name
S3_ENDPOINT=

# ── Cognito ───────────────────────────────────────────────────────────────────
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=your-client-id
COGNITO_CLIENT_SECRET=your-client-secret
COGNITO_TOKEN_URL=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_xxxxxxxxx/.well-known/jwks.json
COGNITO_JWT_ISSUER_URL=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_xxxxxxxxx

# ── Cache ─────────────────────────────────────────────────────────────────────
CACHE_TTL=6h

# ── AI service (FastAPI) ──────────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000
OPENAI_API_KEY=sk-...
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=stuffsy_files
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
VISION_MODEL=gpt-4o
WHISPER_MODEL=whisper-1
SIMILARITY_THRESHOLD=0.30
TOP_K=6

# ── Embed worker ──────────────────────────────────────────────────────────────
EMBED_QUEUE_KEY=stuffsy:embed
SQS_VIDEO_QUEUE_URL=
CHUNK_SIZE=800
CHUNK_OVERLAP=100
